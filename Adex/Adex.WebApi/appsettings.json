{
  "ConnectionStrings": {
    "Adex": "Host=localhost;Port=5433;Database=Adex;Username=postgres;Password=mypassword;"
  },
  "Import": {
    "DataDirectory": "D:\\publish\\adex\\data",
    "FileName": "declarations.csv",
    "ApiKey": "dev-import-key"
  },
  "Dashboard": {
    "TimeToLive": "00:30:00"
  },
  "Csv": {
    "FilePath": "D:\\publish\\adex\\data\\declarations.csv",
    "CacheDurationSeconds": 600
  },
  "Search": {
    "CacheDurationSeconds": 600
  },
  "AllowedHosts": "127.0.0.1;localhost",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Npgsql.Command": "Information",
        "Adex.Application.Csv": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz};[{Level:u3}];{JobId};{Message:l}<{SourceContext}>{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "File",
        "Args": {
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 20971520,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 10,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
