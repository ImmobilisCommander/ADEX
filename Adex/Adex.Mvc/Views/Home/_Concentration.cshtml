@model Adex.Mvc.Models.ConcentrationChartViewModel

<section class="register-section concentration-chart" data-chart-motion="curve" aria-labelledby="concentration-title">
    <div class="section-heading">
        <h2 id="concentration-title">Concentration des montants</h2>
        <span class="section-unit">part cumulée du montant</span>
    </div>
    @if (Model.Curves.Count == 0)
    {
        <p class="empty-state">Aucun montant n’est disponible pour calculer la concentration.</p>
    }
    else
    {
        <svg class="chart-svg" viewBox="@Model.ViewBox" role="img"
             aria-label="Courbe de concentration : part cumulée du montant détenue par les premiers pourcents de chaque population">
            @foreach (var tick in Model.Ticks)
            {
                <line class="chart-grid" x1="40" x2="468" y1="@tick.Y" y2="@tick.Y" />
                @:<text class="chart-label" x="34" y="@tick.AxisY" text-anchor="end">@tick.Label %</text>
                @:<text class="chart-label" x="@tick.X" y="288" text-anchor="middle">@tick.Label %</text>
            }
            <line class="chart-diagonal" x1="@Model.DiagonalX1" y1="@Model.DiagonalY1" x2="@Model.DiagonalX2" y2="@Model.DiagonalY2" />
            @foreach (var curve in Model.Curves)
            {
                <polyline class="chart-line @curve.CssClass" points="@curve.Points" />
            }
        </svg>
        <p class="chart-axis-note">Abscisse : part de la population, classée du montant le plus élevé au plus faible.</p>
        <ul class="chart-legend">
            @foreach (var item in Model.Curves)
            {
                <li>
                    <span class="legend-swatch @item.CssClass" aria-hidden="true"></span>
                    <span>
                        <strong>@item.Curve.Label</strong> :
                        les 1 % premiers détiennent @item.Curve.TopOnePercentShareDisplay % du montant,
                        les 10 premiers @item.Curve.TopTenShareDisplay %
                        (@item.Curve.CountDisplay entités).
                    </span>
                </li>
            }
            <li><span class="legend-swatch chart-diagonal-swatch" aria-hidden="true"></span><span>Répartition parfaitement égale</span></li>
        </ul>
    }
</section>
