@model Adex.Mvc.Models.DisclaimerPageViewModel

<main class="disclaimer-page">
    <header class="disclaimer-intro">
        <h1>@Model.Title</h1>
        <p>Comprendre l’origine des données affichées et la portée des indicateurs d’ADEX.</p>
    </header>

    <section class="register-section disclaimer-section" aria-labelledby="data-source-title">
        <h2 id="data-source-title">Source des données</h2>
        <p>
            Les déclarations consultables dans ADEX proviennent du jeu de données
            <a href="https://www.data.gouv.fr/datasets/transparence-sante-1"
               target="_blank" rel="noopener noreferrer">Transparence-Santé publié sur data.gouv.fr</a>.
            ADEX importe et organise ces données afin de faciliter leur recherche et leur exploration.
        </p>
    </section>

    <section class="register-section disclaimer-section" aria-labelledby="use-title">
        <h2 id="use-title">Utilisation des indicateurs</h2>
        <p>
            Les totaux et classements présentés par ADEX sont calculés à partir des déclarations importées.
            Ils facilitent la navigation dans les données, mais ne remplacent pas la consultation de la source
            ni l’examen des déclarations individuelles.
        </p>
        <p class="disclaimer-source">
            <a href="https://www.data.gouv.fr/datasets/transparence-sante-1"
               target="_blank" rel="noopener noreferrer">Consulter la page source sur data.gouv.fr</a>
        </p>
    </section>
</main>
