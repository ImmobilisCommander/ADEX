@model Adex.Mvc.Models.AmountHistogramChartViewModel

<section class="register-section amount-histogram" aria-labelledby="histogram-title">
    <div class="section-heading">
        <h2 id="histogram-title">Distribution des montants</h2>
        <span class="section-unit">nombre de liens · échelle logarithmique</span>
    </div>
    @if (Model.Bars.Count == 0)
    {
        <p class="empty-state">Aucun montant n’est disponible dans la base.</p>
    }
    else
    {
        <svg class="chart-svg" viewBox="@Model.ViewBox" role="img" aria-label="@Model.AccessibleLabel">
            @foreach (var tick in Model.Ticks)
            {
                <line class="chart-grid" x1="52" x2="472" y1="@tick.Y" y2="@tick.Y" />
                @:<text class="chart-label" x="46" y="@tick.LabelY" text-anchor="end">@tick.Value</text>
            }
            @foreach (var bar in Model.Bars)
            {
                <rect class="chart-bar chart-bar-b" x="@bar.X" y="@bar.Y" width="@bar.Width" height="@bar.Height">
                    <title>@bar.Title</title>
                </rect>
                @if (bar.ShowLabel)
                {
                    @:<text class="chart-label" x="@bar.X" y="280" text-anchor="middle">@bar.Label</text>
                }
            }
        </svg>
        @if (Model.HasNonPositiveBin)
        {
            <p class="chart-axis-note">La tranche « ≤ 0 » regroupe les montants nuls, très majoritaires (conventions dont le montant n’est pas renseigné), et un très petit nombre de montants négatifs (corrections ou erreurs de saisie possibles, origine non vérifiée).</p>
        }
    }
</section>
