@model Adex.Mvc.Views.Home.RankingModel
<section class="register-section top-entities" data-chart-motion="ranking" aria-labelledby="@Model.Id-title">
    <div class="section-heading">
        <h2 id="@Model.Id-title">@Model.Title</h2>
        <span class="section-unit">montants déclarés</span>
    </div>
    @if (Model.Entities.Count == 0)
    {
        <p class="empty-state">Le classement apparaîtra lorsque des liens financiers seront disponibles.</p>
    }
    else
    {
        <ol class="ranking-list">
        @foreach (var item in Model.Items)
        {
            <li>
                <a class="ranking-link" href="/@item.Entity.Id">
                    <span class="rank-number">@item.Rank</span>
                    <span class="ranking-entity">
                        <span class="ranking-name">@item.Entity.Name</span>
                    </span>
                    <span class="ranking-bar" aria-hidden="true"><span style="width: @item.Width%"></span></span>
                    <span class="ranking-amount">@item.Amount</span>
                    <span class="ranking-arrow" aria-hidden="true">↗</span>
                </a>
            </li>
        }
        </ol>
    }
</section>
