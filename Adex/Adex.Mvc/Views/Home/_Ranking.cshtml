@model Adex.Mvc.Views.Home.RankingModel
@using System.Globalization
@{
    var frenchCulture = CultureInfo.GetCultureInfo("fr-FR");
    var topAmount = Model.Entities.Count == 0 ? 0m : Model.Entities.Max(entity => entity.Amount);
}
<section class="register-section top-entities" aria-labelledby="@Model.Id-title">
    <div class="section-heading">
        <h2 id="@Model.Id-title">@Model.Title</h2>
        <span class="section-unit">montants déclarés</span>
    </div>
    @if (Model.Entities.Count == 0)
    {
        <p class="empty-state">Le classement apparaîtra lorsque des liens financiers seront disponibles.</p>
    }
    else
    {
        <ol class="ranking-list">
        @for (var index = 0; index < Model.Entities.Count; index++)
        {
            var entity = Model.Entities[index];
            var width = topAmount == 0 ? 0 : (int)Math.Round((double)(entity.Amount * 100m / topAmount));
            <li>
                <a class="ranking-link" href="/@entity.Id">
                    <span class="rank-number">@((index + 1).ToString("D2", frenchCulture))</span>
                    <span class="ranking-entity">
                        <span class="ranking-name">@entity.Name</span>
                    </span>
                    <span class="ranking-bar" aria-hidden="true"><span style="width: @width%"></span></span>
                    <span class="ranking-amount">@entity.Amount.ToString("C0", frenchCulture)</span>
                    <span class="ranking-arrow" aria-hidden="true">↗</span>
                </a>
            </li>
        }
        </ol>
    }
</section>
