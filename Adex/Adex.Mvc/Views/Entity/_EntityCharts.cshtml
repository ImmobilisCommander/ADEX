@model Adex.Mvc.Models.EntityChartsViewModel

@if (Model.HasContent)
{
<div class="entity-charts">
    <section class="register-section" aria-labelledby="activity-title">
        <div class="section-heading">
            <h2 id="activity-title">Montants par année</h2>
            <span class="section-unit">somme des montants · date du lien</span>
        </div>
        @if (!Model.HasYearlyActivity)
        {
            <p class="empty-state">Aucune déclaration datée n’est disponible pour cette entité.</p>
        }
        else
        {
            <svg class="chart-svg" viewBox="@Model.YearlyChartViewBox" role="img" aria-label="@Model.YearlyChartLabel">
                @foreach (var tick in Model.YearTicks)
                {
                    <line class="chart-grid" x1="64" x2="472" y1="@tick.Y" y2="@tick.Y" />
                    @:<text class="chart-label" x="58" y="@tick.LabelY" text-anchor="end">@tick.Value</text>
                }
                @foreach (var bar in Model.YearBars)
                {
                    <rect class="chart-bar" x="@bar.X" y="@bar.Y" width="@bar.Width" height="@bar.Height">
                        <title>@bar.Title</title>
                    </rect>
                    @if (bar.Year is not null)
                    {
                        @:<text class="chart-label" x="@bar.LabelX" y="212" text-anchor="middle">@bar.Year</text>
                    }
                }
            </svg>
        }
    </section>

    <section class="register-section" aria-labelledby="breakdown-title">
        <div class="section-heading">
            <h2 id="breakdown-title">Répartition par typologie</h2>
            <span class="section-unit">liens · montants</span>
        </div>
        @if (!Model.HasTypeBreakdown)
        {
            <p class="empty-state">Aucun lien financier n’est associé à cette entité.</p>
        }
        else
        {
            <div class="stacked-bar" role="img" aria-label="Répartition des liens par typologie">
                @foreach (var item in Model.TypeBreakdown)
                {
                    <span class="stacked-segment @item.CssClass" style="width: @item.CountShare%" title="@item.CountTitle"></span>
                }
            </div>
            <p class="chart-axis-note">Nombre de liens</p>
            <div class="stacked-bar" role="img" aria-label="Répartition des montants par typologie">
                @foreach (var item in Model.TypeBreakdown)
                {
                    <span class="stacked-segment @item.CssClass" style="width: @item.AmountShare%" title="@item.AmountTitle"></span>
                }
            </div>
            <p class="chart-axis-note">Montants</p>
            <ul class="chart-legend">
                @foreach (var item in Model.TypeBreakdown)
                {
                    <li>
                        <span class="legend-swatch @item.CssClass" aria-hidden="true"></span>
                        <span><strong>@item.Item.Type</strong> : @item.Item.CountDisplay liens
                            (@item.CountShare %) · @item.Item.AmountDisplay</span>
                    </li>
                }
            </ul>
        }
    </section>
</div>
}
