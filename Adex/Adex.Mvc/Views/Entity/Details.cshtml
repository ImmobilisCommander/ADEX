@model Adex.Mvc.Models.EntityDetailsViewModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Name;
    var frenchCulture = CultureInfo.GetCultureInfo("fr-FR");
}

<main class="explorer-page entity-page">
    <a class="back-link" href="/">← Tableau de bord</a>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="error-state" role="alert">@Model.ErrorMessage</p>
    }
    else
    {
    <header class="entity-heading">
        <div>
            <p class="entity-type">@Model.Type</p>
            <h1>@Model.Name</h1>
        </div>
        <a class="plain-link" href="/Search">Rechercher une autre entité</a>
    </header>

    <section class="summary-register entity-totals" aria-label="Synthèse des liens">
        <div class="summary-item">
            <span class="summary-label">Liens financiers</span>
            <strong>@Model.FinancialLinkCount.ToString("N0", frenchCulture)</strong>
        </div>
        <div class="summary-item">
            <span class="summary-label">Montants vers cette entité</span>
            <strong>@Model.IncomingAmount.ToString("C0", frenchCulture)</strong>
        </div>
        <div class="summary-item summary-total">
            <span class="summary-label">Montants depuis cette entité</span>
            <strong>@Model.OutgoingAmount.ToString("C0", frenchCulture)</strong>
        </div>
    </section>

    <section class="register-section" aria-labelledby="attributes-title">
        <div class="section-heading">
            <h2 id="attributes-title">Informations disponibles</h2>
            <span class="section-unit">@Model.Attributes.Count.ToString("N0", frenchCulture) attributs</span>
        </div>
        @if (Model.Attributes.Count == 0)
        {
            <p class="empty-state">Aucune information complémentaire n’est disponible pour cette entité.</p>
        }
        else
        {
            <dl class="attribute-list">
            @foreach (var attribute in Model.Attributes)
            {
                <div class="attribute-row">
                    <dt>@(attribute.Name)</dt>
                    <dd>@(attribute.Value)</dd>
                </div>
            }
            </dl>
        }
    </section>

    <section class="register-section entity-links" aria-labelledby="links-title">
        <div class="section-heading">
            <h2 id="links-title">Liens financiers</h2>
            <span class="section-unit">@Model.FinancialLinkCount.ToString("N0", frenchCulture) déclarations</span>
        </div>
        @if (Model.FinancialLinks.Count == 0)
        {
            <p class="empty-state">Aucun lien financier n’est associé à cette entité.</p>
        }
        else
        {
            <div class="table-scroll">
                @{
                    string SortUrl(string key)
                    {
                        var descending = Model.Sort == key ? !Model.Descending : key is "date" or "amount";
                        return $"/{Model.Id}?page=1&pageSize={Model.PageSize}&sort={key}&descending={descending.ToString().ToLowerInvariant()}#links-title";
                    }
                    string SortState(string key) => Model.Sort == key ? (Model.Descending ? "descending" : "ascending") : null;
                }
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col" aria-sort="@SortState("direction")"><a class="sort-button" href="@SortUrl("direction")" title="Trier par sens"><span>Sens</span><i aria-hidden="true"></i></a></th>
                            <th scope="col" aria-sort="@SortState("name")"><a class="sort-button" href="@SortUrl("name")" title="Trier par contrepartie"><span>Contrepartie</span><i aria-hidden="true"></i></a></th>
                            <th scope="col" aria-sort="@SortState("type")"><a class="sort-button" href="@SortUrl("type")" title="Trier par typologie"><span>Typologie</span><i aria-hidden="true"></i></a></th>
                            <th scope="col" aria-sort="@SortState("kind")"><a class="sort-button" href="@SortUrl("kind")" title="Trier par nature"><span>Nature / objet</span><i aria-hidden="true"></i></a></th>
                            <th scope="col">Justification</th>
                            <th scope="col" class="numeric" aria-sort="@SortState("date")"><a class="sort-button" href="@SortUrl("date")" title="Trier par date"><span>Date</span><i aria-hidden="true"></i></a></th>
                            <th scope="col" class="numeric" aria-sort="@SortState("amount")"><a class="sort-button" href="@SortUrl("amount")" title="Trier par montant"><span>Montant</span><i aria-hidden="true"></i></a></th>
                        </tr></thead>
                    <tbody>
                    @foreach (var link in Model.FinancialLinks)
                    {
                        var motif = link.Justification.FirstOrDefault(item => item.Name == "Motif")?.Value;
                        var hasJustification = link.Justification.Count > 0;
                        <tr class="@(hasJustification ? "row-detail" : null)" tabindex="@(hasJustification ? "0" : null)"
                            aria-label="@(hasJustification ? "Voir la justification : " + link.CounterpartyName : null)"
                            data-justification-row="@(hasJustification ? "true" : null)">
                            <td>@(link.Outgoing ? "Vers" : "Depuis")</td>
                            <th scope="row" data-sort="@link.CounterpartyName"><a href="/@link.CounterpartyId">@link.CounterpartyName</a></th>
                            <td>@link.DeclarationType</td>
                            <td>@(string.IsNullOrWhiteSpace(link.Kind) ? "—" : link.Kind)</td>
                            <td data-sort="@motif">
                                @(string.IsNullOrWhiteSpace(motif) ? "—" : motif)
                                @if (hasJustification)
                                {
                                    <template>
                                        <dl>
                                            @foreach (var item in link.Justification)
                                            {
                                                <dt>@item.Name</dt>
                                                <dd>@item.Value</dd>
                                            }
                                        </dl>
                                    </template>
                                }
                            </td>
                            <td class="numeric" data-sort="@link.Date.Ticks">@link.Date.ToString("d", frenchCulture)</td>
                            <td class="numeric" data-sort="@link.Amount.ToString(CultureInfo.InvariantCulture)">@link.Amount.ToString("C0", frenchCulture)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="table-note">Cliquez sur une ligne pour voir sa justification.</p>
            @if (Model.FinancialLinkCount > 10)
            {
                var first = (Model.Page - 1) * Model.PageSize + 1;
                var last = first + Model.FinancialLinks.Count - 1;
                var pages = new List<int> { 1, Model.PageCount };
                for (var n = Model.Page - 2; n <= Model.Page + 2; n++)
                {
                    pages.Add(n);
                }
                pages = pages.Where(n => n >= 1 && n <= Model.PageCount).Distinct().OrderBy(n => n).ToList();
                string PageUrl(int n) => $"/{Model.Id}?page={n}&pageSize={Model.PageSize}&sort={Model.Sort}&descending={Model.Descending.ToString().ToLowerInvariant()}#links-title";
                <div class="pager-bar">
                    <nav class="pager" aria-label="Pagination des liens financiers">
                        @if (Model.Page > 1)
                        {
                            <a class="pager-link" rel="prev" href="@PageUrl(Model.Page - 1)">Précédent</a>
                        }
                        @for (var i = 0; i < pages.Count; i++)
                        {
                            if (i > 0 && pages[i] - pages[i - 1] > 1)
                            {
                                <span class="pager-gap" aria-hidden="true">…</span>
                            }
                            if (pages[i] == Model.Page)
                            {
                                <span class="pager-link is-current" aria-current="page">@pages[i].ToString("N0", frenchCulture)</span>
                            }
                            else
                            {
                                <a class="pager-link" href="@PageUrl(pages[i])" aria-label="Page @pages[i]">@pages[i].ToString("N0", frenchCulture)</a>
                            }
                        }
                        @if (Model.Page < Model.PageCount)
                        {
                            <a class="pager-link" rel="next" href="@PageUrl(Model.Page + 1)">Suivant</a>
                        }
                    </nav>
                    <form method="get" action="/@Model.Id" class="pager-size">
                        <label for="page-size">Par page</label>
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="descending" value="@Model.Descending.ToString().ToLowerInvariant()" />
                        <select id="page-size" name="pageSize" data-autosubmit>
                            @foreach (var size in new[] { 10, 20, 50 })
                            {
                                <option value="@size" selected="@(size == Model.PageSize)">@size</option>
                            }
                        </select>
                        <noscript><button type="submit" class="pager-link">Appliquer</button></noscript>
                    </form>
                </div>
                <p class="table-note">
                    Déclarations @first.ToString("N0", frenchCulture) à @last.ToString("N0", frenchCulture)
                    sur @Model.FinancialLinkCount.ToString("N0", frenchCulture).
                </p>
            }
        }
    </section>
    }
</main>

<dialog id="justification-dialog" class="justification-dialog" aria-labelledby="justification-title">
    <form method="dialog" class="justification-head">
        <h2 id="justification-title">Justification de la déclaration</h2>
        <button type="submit" class="justification-close" aria-label="Fermer">×</button>
    </form>
    <div class="justification-body"></div>
</dialog>

@section Scripts {
    <script src="~/js/justification.js" asp-append-version="true"></script>

}
