@model Adex.Mvc.Entities.EntityDetailsViewModel

<main class="explorer-page entity-page">
    <a class="back-link" href="/">← Tableau de bord</a>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="error-state" role="alert">@Model.ErrorMessage</p>
    }
    else
    {
    <header class="entity-heading">
        <div>
            <p class="entity-type">@Model.Type</p>
            <h1>@Model.Name</h1>
        </div>
        @if (Model.ShowSearchLink)
        {
            <a class="plain-link" href="@Model.SearchUrl">Rechercher une autre entité</a>
        }
    </header>

    <section class="summary-register entity-totals" aria-label="Synthèse des liens">
        <div class="summary-item">
            <span class="summary-label">Liens financiers</span>
            <strong>@Model.FinancialLinkCountDisplay</strong>
        </div>
        <div class="summary-item">
            <span class="summary-label">Montants vers cette entité</span>
            <strong>@Model.IncomingAmountDisplay</strong>
        </div>
        <div class="summary-item summary-total">
            <span class="summary-label">Montants depuis cette entité</span>
            <strong>@Model.OutgoingAmountDisplay</strong>
        </div>
    </section>

    <partial name="_EntityCharts" model="Model.EntityCharts" />

    @if (Model.PlanetaryCounterparties.Count > 0)
    {
        <section class="register-section planetary-section" aria-labelledby="planetary-title">
            <div class="section-heading planetary-heading">
                <div>
                    <h2 id="planetary-title">Système relationnel</h2>
                    <span class="section-unit" data-planetary-count-display>@Model.PlanetaryLinkScopeDisplay</span>
                </div>
                @if (Model.TotalCounterpartiesCount > 1)
                {
                    <form method="get" action="@Model.PageAction" class="planetary-limit-form" data-planetary-form>
                        @if (!string.IsNullOrEmpty(Model.SearchQuery))
                        {
                            <input type="hidden" name="fromQuery" value="@Model.SearchQuery" />
                        }
                        @if (Model.Page > 1)
                        {
                            <input type="hidden" name="page" value="@Model.Page" />
                        }
                        @if (Model.PageSize != 20)
                        {
                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        }
                        @if (Model.Sort != "date")
                        {
                            <input type="hidden" name="sort" value="@Model.Sort" />
                        }
                        @if (!Model.Descending)
                        {
                            <input type="hidden" name="descending" value="false" />
                        }
                        <div class="planetary-slider-wrap">
                            <label for="planetary-limit-slider" class="planetary-slider-label">
                                <span>Contreparties :</span>
                                <strong data-planetary-limit-value>@Model.PlanetaryLimit</strong>
                                <span class="planetary-slider-max">/ @Model.TotalCounterpartiesCount</span>
                            </label>
                            <input type="range"
                                   id="planetary-limit-slider"
                                   name="limit"
                                   min="1"
                                   max="@Model.TotalCounterpartiesCount"
                                   value="@Model.PlanetaryLimit"
                                   step="1"
                                   class="planetary-slider"
                                   data-planetary-slider
                                   data-planetary-url="/@Model.Id/planetary"
                                   aria-label="Nombre de contreparties à afficher" />
                            <noscript>
                                <button type="submit" class="button button-small">OK</button>
                            </noscript>
                        </div>
                    </form>
                }
            </div>
            <div class="planetary-legend" aria-label="Sens des liens">
                <span><i class="planetary-legend-dot planetary-satellite-outgoing" aria-hidden="true"></i>Depuis cette entité</span>
                <span><i class="planetary-legend-dot planetary-satellite-incoming" aria-hidden="true"></i>Vers cette entité</span>
                <span><i class="planetary-legend-dot planetary-satellite-mixed" aria-hidden="true"></i>Dans les deux sens</span>
                <span class="planetary-legend-orbits"><i class="planetary-legend-dash" aria-hidden="true"></i>Orbite extérieure : montants majeurs · Orbites intérieures : survoler</span>
            </div>
            <div class="planetary-active-bar" data-planetary-active-bar aria-live="polite">
                <span data-planetary-active-default class="planetary-active-default">Survolez ou cliquez sur une contrepartie pour afficher ses détails</span>
                <strong data-planetary-active-name class="planetary-active-name"></strong>
                <span data-planetary-active-amount class="planetary-active-amount"></span>
            </div>
            <div class="planetary-container" data-planetary-container>
                @await Html.PartialAsync("_PlanetaryViewport", Model.PlanetarySystem)
            </div>
            <p class="planetary-mobile-hint">Faites défiler horizontalement pour explorer toutes les contreparties.</p>
            <p class="table-note">La taille des satellites reflète le montant cumulé des liens affichés. Les montants les plus élevés gravitent sur l'orbite extérieure avec libellé permanent ; les orbites intérieures affichent le libellé au survol.</p>
        </section>
    }

    <section class="register-section" aria-labelledby="attributes-title">
        <div class="section-heading">
            <h2 id="attributes-title">Informations disponibles</h2>
            <span class="section-unit">@Model.AttributeCountDisplay attributs</span>
        </div>
        @if (Model.Attributes.Count == 0)
        {
            <p class="empty-state">Aucune information complémentaire n’est disponible pour cette entité.</p>
        }
        else
        {
            <dl class="attribute-list">
            @foreach (var attribute in Model.Attributes)
            {
                <div class="attribute-row">
                    <dt>@(attribute.Name)</dt>
                    <dd>@(attribute.Value)</dd>
                </div>
            }
            </dl>
        }
    </section>

    <section class="register-section entity-links" aria-labelledby="links-title">
        <div class="section-heading">
            <h2 id="links-title">Liens financiers</h2>
            <span class="section-unit">@Model.FinancialLinkCountDisplay déclarations</span>
        </div>
        @if (Model.FinancialLinks.Count == 0)
        {
            <p class="empty-state">Aucun lien financier n’est associé à cette entité.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col" aria-sort="@Model.SortLinks["direction"].State"><a class="sort-button" href="@Model.SortLinks["direction"].Url" title="Trier par sens"><span>Sens</span><i aria-hidden="true"></i></a></th>
                            <th scope="col" aria-sort="@Model.SortLinks["name"].State"><a class="sort-button" href="@Model.SortLinks["name"].Url" title="Trier par contrepartie"><span>Contrepartie</span><i aria-hidden="true"></i></a></th>
                            <th scope="col" aria-sort="@Model.SortLinks["type"].State"><a class="sort-button" href="@Model.SortLinks["type"].Url" title="Trier par typologie"><span>Typologie</span><i aria-hidden="true"></i></a></th>
                            <th scope="col" aria-sort="@Model.SortLinks["kind"].State"><a class="sort-button" href="@Model.SortLinks["kind"].Url" title="Trier par nature"><span>Nature / objet</span><i aria-hidden="true"></i></a></th>
                            <th scope="col">Justification</th>
                            <th scope="col" class="numeric" aria-sort="@Model.SortLinks["date"].State"><a class="sort-button" href="@Model.SortLinks["date"].Url" title="Trier par date"><span>Date</span><i aria-hidden="true"></i></a></th>
                            <th scope="col" class="numeric" aria-sort="@Model.SortLinks["amount"].State"><a class="sort-button" href="@Model.SortLinks["amount"].Url" title="Trier par montant"><span>Montant</span><i aria-hidden="true"></i></a></th>
                        </tr></thead>
                    <tbody>
                    @foreach (var link in Model.FinancialLinks)
                    {
                        <tr class="@link.RowClass" tabindex="@link.RowTabIndex"
                            aria-label="@link.RowLabel"
                            data-justification-row="@link.HasJustificationAttribute">
                            <td>@link.DirectionDisplay</td>
                            <th scope="row" data-sort="@link.CounterpartyName"><a href="@link.CounterpartyUrl">@link.CounterpartyName</a></th>
                            <td>@link.DeclarationType</td>
                            <td>@link.KindDisplay</td>
                            <td data-sort="@link.Motif">
                                @link.MotifDisplay
                                @if (link.HasJustification)
                                {
                                    <template>
                                        <dl>
                                            @foreach (var item in link.Justification)
                                            {
                                                <dt>@item.Name</dt>
                                                <dd>@item.Value</dd>
                                            }
                                        </dl>
                                    </template>
                                }
                            </td>
                            <td class="numeric" data-sort="@link.DateSortValue">@link.DateDisplay</td>
                            <td class="numeric" data-sort="@link.AmountSortValue">@link.AmountDisplay</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="table-note">Cliquez sur une ligne pour voir sa justification.</p>
            @if (Model.FinancialLinkCount > 10)
            {
                <div class="pager-bar">
                    <nav class="pager" aria-label="Pagination des liens financiers">
                        @if (Model.Page > 1)
                        {
                            <a class="pager-link" rel="prev" href="@Model.PreviousPageUrl">Précédent</a>
                        }
                        @foreach (var pageLink in Model.PageLinks)
                        {
                            @if (pageLink.GapBefore)
                            {
                                <span class="pager-gap" aria-hidden="true">…</span>
                            }
                            @if (pageLink.Current)
                            {
                                <span class="pager-link is-current" aria-current="page">@pageLink.Number</span>
                            }
                            else
                            {
                                <a class="pager-link" href="@pageLink.Url" aria-label="Page @pageLink.Number">@pageLink.Number</a>
                            }
                        }
                        @if (Model.Page < Model.PageCount)
                        {
                            <a class="pager-link" rel="next" href="@Model.NextPageUrl">Suivant</a>
                        }
                    </nav>
                    <form method="get" action="@Model.PageAction" class="pager-size">
                        <label for="page-size">Par page</label>
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input type="hidden" name="descending" value="@Model.DescendingDisplay" />
                        @if (Model.HasSearchQuery)
                        {
                            <input type="hidden" name="fromQuery" value="@Model.SearchQuery" />
                        }
                        <select id="page-size" name="pageSize" data-autosubmit>
                            @foreach (var size in Model.PageSizeOptions)
                            {
                                <option value="@size" selected="@(size == Model.PageSize)">@size</option>
                            }
                        </select>
                        <noscript><button type="submit" class="pager-link">Appliquer</button></noscript>
                    </form>
                </div>
                <p class="table-note">
                    Déclarations @Model.FirstDisplayedLink à @Model.LastDisplayedLink
                    sur @Model.FinancialLinkCountDisplay.
                </p>
            }
        }
    </section>
    }
</main>

<dialog id="justification-dialog" class="justification-dialog" aria-labelledby="justification-title">
    <form method="dialog" class="justification-head">
        <h2 id="justification-title">Justification de la déclaration</h2>
        <button type="submit" class="justification-close" aria-label="Fermer">×</button>
    </form>
    <div class="justification-body"></div>
</dialog>

@section Scripts {
    <script src="~/js/justification.js" asp-append-version="true"></script>
    <script src="~/js/entity-sort.js" asp-append-version="true"></script>
    <script src="~/js/entity-planetary.js" asp-append-version="true"></script>

}
