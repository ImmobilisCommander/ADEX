<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ADEX</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" sizes="any" href="~/favicon.ico" />
    <script>
        try {
            const savedTheme = localStorage.getItem("adex-theme");
            if (savedTheme === "dark") document.documentElement.dataset.theme = "dark";
        } catch {
            // The light theme remains available when browser storage is disabled.
        }
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="site-nav" aria-label="Navigation principale">
            <a class="brand-mark" href="/" aria-label="ADEX, accueil">ADEX<span>.</span></a>
            <a class="nav-current" href="/">Explorer les données</a>
            <span class="nav-context">Liens d’intérêt · données déclaratives</span>
            <div class="nav-menu" data-nav-menu>
                <button class="nav-burger" type="button" aria-expanded="false" aria-controls="nav-menu-list" aria-label="Menu" data-nav-menu-toggle>
                    <span class="nav-burger-bar" aria-hidden="true"></span>
                    <span class="nav-burger-bar" aria-hidden="true"></span>
                    <span class="nav-burger-bar" aria-hidden="true"></span>
                </button>
                <ul class="nav-menu-list" id="nav-menu-list" hidden>
                    <li><a class="nav-menu-item" href="/Csv">Interroger le CSV</a></li>
                    <li><a class="nav-menu-item" href="/Home/Settings" aria-current="@(ViewData["SettingsAriaCurrent"])">Paramètres</a></li>
                    <li><a class="nav-menu-item" href="/Home/Disclaimer">Source et avertissement</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="site-shell">
        @RenderBody()
    </div>

    <footer class="site-footer">
        <div class="site-shell footer-inner">
            <span>ADEX · Exploration des données déclaratives</span>
            <div class="footer-links">
                <a href="/">Retour au tableau de bord</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
