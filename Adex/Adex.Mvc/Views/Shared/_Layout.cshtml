<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ADEX</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="site-nav" aria-label="Navigation principale">
            <a class="brand-mark" href="/" aria-label="ADEX, accueil">ADEX<span>.</span></a>
            <a class="nav-current" href="/">Explorer les données</a>
            <span class="nav-context">Liens d’intérêt · données déclaratives</span>
        </nav>
    </header>
    <div class="site-shell">
        @RenderBody()
    </div>

    <footer class="site-footer">
        <div class="site-shell footer-inner">
            <span>ADEX · Exploration des données déclaratives</span>
            <a href="/">Retour au tableau de bord</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
